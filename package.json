{
  "name": "@alysoid/ahk-build",
  "version": "0.1.0-rc.1",
  "description": "A reproducible build, packaging, and release workflow for AutoHotkey v2 projects.",
  "keywords": [
    "autohotkey",
    "ahk",
    "ahk2exe",
    "build",
    "wix",
    "windows"
  ],
  "license": "MIT",
  "author": "Andrea Brandi",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alysoid/ahk-build.git"
  },
  "bugs": {
    "url": "https://github.com/alysoid/ahk-build/issues"
  },
  "homepage": "https://github.com/alysoid/ahk-build#readme",
  "bin": {
    "ahk-build": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write . --list-different",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "pack:check": "node scripts/pack-check.mjs",
    "tarball:smoke": "node scripts/tarball-smoke.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "tinyglobby": "^0.2.17",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/yazl": "^2.4.5",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.9.6",
    "tsx": "^4.22.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
